# ==============================================================================
# ПРИМЕР ШАБЛОНА КОНФИГУРАЦИИ ОКРУЖЕНИЯ (.env.example)
# Для работы скопируйте этот файл в .env и заполните актуальными значениями:
# cp .env.example .env
# ==============================================================================

# --- НАСТРОЙКИ МОДЕЛЕЙ GOOGLE VERTEX AI / LITELLM ---
# Идентификатор проекта в Google Cloud Platform
VERTEX_PROJECT=financial-ai-agent-0
# Регион развертывания моделей (например, global, us-central1)
VERTEX_LOCATION=global
# Базовый адрес прокси или эндпоинта для вызова моделей
VERTEX_BASE_URL=https://proxy.example.com
# Модель для основных рассуждений главного агента
MAIN_MODEL_NAME=vertex_ai/gemini-2.5-pro
MAIN_REASONING_EFFORT=high
# Модель для анализа нормативных документов в RAG
RAG_DATA_MODEL_NAME=vertex_ai/gemini-2.5-flash
RAG_DATA_REASONING_EFFORT=low

# --- ПОИСКОВЫЙ API (TAVILY) ---
TAVILY_API_KEY=tvly-example-key
TAVILY_BASE_URL=https://api.tavily.com

# --- БАЗА ДАННЫХ POSTGRESQL ---
POSTGRES_USER=financial_ai_agent
POSTGRES_PASSWORD=change_this_strong_password_in_production
POSTGRES_DB=financial_agent
# Режим шифрования соединения PostgreSQL (disable, prefer, require, verify-ca, verify-full)
POSTGRES_SSLMODE=prefer

# Панель управления pgAdmin4
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_this_pgadmin_password

# --- БЕЗОПАСНОСТЬ И АВТОРИЗАЦИЯ (АСИММЕТРИЧНЫЙ JWT RS256) ---
# Пути к файлам RSA-ключей (PKCS#8 PEM приватный и X.509 SPKI PEM публичный)
# При отсутствии путей сервер генерирует временную пару в памяти (только dev-режим)
JWT_PRIVATE_KEY_PATH=/etc/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/etc/secrets/jwt_public.pem
# Либо строковые переменные (приватный ключ для подписи, публичный для проверки):
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Сроки действия токенов безопасности:
# Короткоживущий токен доступа (минуты, по умолчанию 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Долгоживущий токен обновления для ротации RTR (дни, по умолчанию 7)
REFRESH_TOKEN_EXPIRE_DAYS=7
# Двухфакторная аутентификация 2FA (TOTP RFC 6238, Google Authenticator / FreeOTP):
# Секретный ключ Base32 (32 символа, например, сгенерированный через pyotp.random_base32())
ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP
# Принудительное требование 2FA (true/false)
REQUIRE_2FA=true
# Bcrypt-хэш пароля администратора для входа в панель
ADMIN_PASSWORD_HASH=$2b$12$eXampLeHaShValueForAdMinPassWordPlaceholder

# --- ВЗАИМНАЯ АУТЕНТИФИКАЦИЯ MTLS И ЗАЩИТА ТРАФИКА IN-TRANSIT (ZERO TRUST) ---
# Принудительное требование валидного клиентского TLS-сертификата (true/false)
REQUIRE_MTLS=false
# Список доверенных субъектов клиентских сертификатов (CN или полный Subject через запятую)
# Пример: ALLOWED_MTLS_SUBJECTS=admin-client,desktop-app
ALLOWED_MTLS_SUBJECTS=
# Список доверенных издателей сертификатов (эмитентов CA через запятую)
ALLOWED_MTLS_ISSUERS=
# Режим аутентификации клиентов в Edge Reverse Proxy Caddy: request, require, verify_if_given
CADDY_CLIENT_AUTH_MODE=request

# --- ШИФРОВАНИЕ ДАННЫХ ПРИ ХРАНЕНИИ (DATA AT REST / AES-256-GCM / ENVELOPE) ---
# 256-битный мастер-ключ шифрования на уровне приложения (64 hex-символа или 32 байта base64)
# Генерация ключа: openssl rand -hex 32
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- ОБЪЕКТНОЕ ХРАНИЛИЩЕ MINIO (S3) И СЕРВЕРНОЕ ШИФРОВАНИЕ (SSE) ---
MINIO_ACCESS_KEY=minio_access_key_placeholder
MINIO_SECRET_KEY=minio_secret_key_placeholder
# Защищенное соединение MinIO In-Transit через HTTPS/TLS (true/false)
MINIO_SECURE=false
# Включение серверного шифрования объектов при хранении (SSE-S3 / SSE-C)
MINIO_SSE_ENABLED=true
# Тип серверного шифрования: s3 (через KMS) или ssec (ключ клиента)
MINIO_SSE_TYPE=s3
# Встроенный ключ KMS для MinIO SSE-S3 (имя_ключа:32_байта_hex)
# Генерация: echo "financial-kms-key:$(openssl rand -hex 32)"
MINIO_KMS_SECRET_KEY=financial-kms-key:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Опционально: клиентский ключ для SSE-C (32 байта hex), если MINIO_SSE_TYPE=ssec
# MINIO_SSE_C_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- БРОКЕР ОЧЕРЕДЕЙ И КЭШ REDIS ---
REDIS_PASSWORD=change_this_redis_password
# Защищенное соединение Redis In-Transit через SSL/TLS (true/false)
REDIS_SSL=false

# --- ВЕКТОРИЗАЦИЯ И ХРАНИЛИЩЕ CHROMADB ---
# Модель генерации эмбеддингов
EMBEDDING_MODEL_NAME=gemini-embedding-2
# Параметры нарезки и батчинга текста
CHUNK_BATCH_SIZE=10
CHUNK_SLEEP_SECONDS=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
# Токен авторизации для ChromaDB
CHROMA_AUTH_TOKEN=chroma_token_secret_placeholder
# Конвертное шифрование чанков и метаданных в ChromaDB (AES-256-GCM Envelope Encryption)
CHROMA_ENVELOPE_ENCRYPTION_ENABLED=true

# --- BOOTSTRAP-ТОКЕНЫ АГЕНТОВ (ВЗАИМОДЕЙСТВИЕ МИКРОСЕРВИСОВ) ---
AGENT_DIGITAL_BOOTSTRAP_TOKEN=bootstrap_token_digital_agent_secret
AGENT_BANK_BOOTSTRAP_TOKEN=bootstrap_token_bank_agent_secret
AGENT_INVEST_BOOTSTRAP_TOKEN=bootstrap_token_invest_agent_secret
AGENT_MAIN_BOOTSTRAP_TOKEN=bootstrap_token_main_agent_secret

# --- СЕРВИС РАСПОЗНАВАНИЯ ДОКУМЕНТОВ CONTENT AI (ABBYY FLEXICAPTURE) ---
CONTENTAI_USERNAME=contentai_user
CONTENTAI_PASSWORD=contentai_password
CONTENT_AI_API_URI=http://contentai.example.com/FlexiCapture12/Server/ContentCaptureWS.asmx
