# Публичный site block слушает только адрес edge-сети.
# Внутренние имена слушают адреса сетей Docker и не принимают соединение
# с опубликованного порта, потому что docker-proxy приходит со шлюза .1.

# Публичный вход предъявляет отдельный сертификат границы. Ключ JWT сюда не монтируется.
{$ADMIN_DOMAIN:admin.fin-ai-agent.ru}, {$ADMIN_LOCAL_DOMAIN:admin.fin-ai-agent.local} {
    bind 10.90.10.10

    tls /etc/caddy/edge/caddy.crt /etc/caddy/edge/caddy.key {
        protocols tls1.3
        client_auth {
            mode {$CADDY_CLIENT_AUTH_MODE:require_and_verify}
            trusted_ca_cert_file /etc/caddy/certs/ca.crt
        }
    }

    # Субъект сертификата в CEL имеет тип pkix.Name. Приведение string()
    # в Caddy 2.11 не имеет перегрузки и обрывает любой запрос пустым 500.
    # Replacer вызывает String() и кладёт DN в заголовок, по которому
    # публичный вход узнаёт сертификат банка.
    route {
        request_header X-Edge-Client-Subject {tls_client_subject}

        @bank_client header_regexp X-Edge-Client-Subject bank_service|bank_operator|bank-simulation

        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Referrer-Policy "strict-origin-when-cross-origin"
            Permissions-Policy "camera=(), microphone=(), geolocation=()"
            -Server
        }

        abort @bank_client

        # header_up удаляет поле после записи, поэтому маска там стирает
        # уже проверенные значения. Подделку снимает request_header.
        request_header -X-Client-Cert-*
        request_header -X-Proxy-Secret

        reverse_proxy admin-server:8000 {
            header_up -X-Edge-Client-Subject
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
            header_up X-Proxy-Secret "{$PROXY_INTERNAL_SECRET}"
            # Плейсхолдера статуса проверки нет: непроверенный сертификат
            # обрывается на рукопожатии require_and_verify и сюда не доходит.
            header_up X-Client-Cert-Verify SUCCESS
            header_up X-Client-Cert-Subject {tls_client_subject}
            header_up X-Client-Cert-Issuer {tls_client_issuer}
            header_up X-Client-Cert-Serial {tls_client_serial}
            header_up X-Client-Cert-Fingerprint {tls_client_fingerprint}
            header_up X-Client-Cert-Pem {tls_client_escaped_cert}

            transport http {
                response_header_timeout 180s
                read_timeout 180s
                write_timeout 180s
            }
        }
    }
}

# Внутренний банковский контур слушает адреса 10.90.20.10 и 10.90.30.10.
simulation-api.internal, bank-service.internal {
    bind 10.90.20.10 10.90.30.10

    tls internal {
        protocols tls1.3
        client_auth {
            mode {$CADDY_CLIENT_AUTH_MODE:require_and_verify}
            trusted_ca_cert_file /etc/caddy/certs/ca.crt
        }
    }

    # Шлюз моста принадлежит docker-proxy, потому что прокси хоста выходит в контейнер с этого адреса.
    @docker_proxy remote_ip 10.90.10.1 10.90.20.1 10.90.30.1
    @outside not remote_ip 10.90.20.0/24 10.90.30.0/24

    route {
        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            -Server
        }

        abort @docker_proxy
        abort @outside

        # Снимает заголовки, которые выставляет сам Caddy.
        # X-Agent-Cert, X-Enclave-Cert, X-Cert и X-Signature клиента внутреннего имени сохраняет.
        # Шифрует последний переход сертификатом банка: SAN содержит simulation-api,
        # а доверие берётся из корневого сертификата платформы.
        # Передаёт серийный номер клиентского сертификата, чтобы шлюз сверил его со списком отзыва.
        # Поддельные заголовки сертификата снимаются до записи проверенных значений.
        request_header -X-Client-Cert-*
        request_header -X-Proxy-Secret

        reverse_proxy https://simulation-api:8002 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
            header_up X-Proxy-Secret "{$PROXY_INTERNAL_SECRET}"
            # Плейсхолдера статуса проверки нет: непроверенный сертификат
            # обрывается на рукопожатии require_and_verify и сюда не доходит.
            header_up X-Client-Cert-Verify SUCCESS
            header_up X-Client-Cert-Subject {tls_client_subject}
            header_up X-Client-Cert-Issuer {tls_client_issuer}
            header_up X-Client-Cert-Serial {tls_client_serial}
            header_up X-Client-Cert-Fingerprint {tls_client_fingerprint}

            transport http {
                tls
                tls_server_name simulation-api
                tls_trust_pool file {
                    pem_file /etc/caddy/certs/ca.crt
                }
                response_header_timeout 60s
                read_timeout 60s
                write_timeout 60s
            }
        }
    }
}

# Внутренний контур администратора слушает те же адреса сетей Docker.
admin-server.internal {
    bind 10.90.20.10 10.90.30.10

    tls internal {
        protocols tls1.3
        client_auth {
            mode {$CADDY_CLIENT_AUTH_MODE:require_and_verify}
            trusted_ca_cert_file /etc/caddy/certs/ca.crt
        }
    }

    @docker_proxy remote_ip 10.90.10.1 10.90.20.1 10.90.30.1
    @outside not remote_ip 10.90.20.0/24 10.90.30.0/24

    route {
        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            -Server
        }

        abort @docker_proxy
        abort @outside

        request_header -X-Client-Cert-*
        request_header -X-Proxy-Secret

        reverse_proxy admin-server:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
            header_up X-Proxy-Secret "{$PROXY_INTERNAL_SECRET}"
            # Плейсхолдера статуса проверки нет: непроверенный сертификат
            # обрывается на рукопожатии require_and_verify и сюда не доходит.
            header_up X-Client-Cert-Verify SUCCESS
            header_up X-Client-Cert-Subject {tls_client_subject}
            header_up X-Client-Cert-Issuer {tls_client_issuer}
            header_up X-Client-Cert-Serial {tls_client_serial}
            header_up X-Client-Cert-Fingerprint {tls_client_fingerprint}
            header_up X-Client-Cert-Pem {tls_client_escaped_cert}

            transport http {
                response_header_timeout 180s
                read_timeout 180s
                write_timeout 180s
            }
        }
    }
}

# Локальный healthcheck отвечает внутри контейнера.
http://127.0.0.1:80, http://localhost:80 {
    handle /health {
        respond "OK" 200
    }
    handle {
        respond "Not Found" 404
    }
}
