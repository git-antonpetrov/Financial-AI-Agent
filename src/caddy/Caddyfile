# -----------------------------------------------------------------------------
# CADDY WEBSERVER / ZERO-TRUST INGRESS & INTERNAL TLS CONFIGURATION
# 1. Внешний контур Администратора: Строгий mTLS (require_and_verify), проверка по Root CA
# 2. Внутренний контур Банковской Симуляции: tls internal для шифрования транзита
# -----------------------------------------------------------------------------

# 1. Внешний защищенный шлюз Администратора
{$ADMIN_DOMAIN:admin.fin-ai-agent.ru}, {$ADMIN_LOCAL_DOMAIN:admin.fin-ai-agent.local} {
    # Строгие протоколы TLS 1.3 / TLS 1.2 и безопасные наборы шифров
    tls {
        protocols tls1.2 tls1.3
        ciphers TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
        
        # Взаимная аутентификация TLS (mTLS)
        # В боевом контуре требует обязательный клиентский сертификат, подписанный Root CA
        client_auth {
            mode {$CADDY_CLIENT_AUTH_MODE:require_and_verify}
            trusted_ca_cert_file /etc/caddy/certs/ca.crt
        }
    }

    # Заголовки безопасности HTTP
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Проксирование запросов к FastAPI Admin Server с mTLS-заголовками и таймаутами для LLM
    reverse_proxy admin-server:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
        header_up X-Client-Cert-Verify {tls_client_verified}
        header_up X-Client-Cert-Subject {tls_client_subject}
        header_up X-Client-Cert-Issuer {tls_client_issuer}
        header_up X-Client-Cert-Serial {tls_client_serial}
        header_up X-Client-Cert-Fingerprint {tls_client_fingerprint}

        transport http {
            response_header_timeout 180s
            read_timeout 180s
            write_timeout 180s
        }
    }
}

# 2. Внутренний банковский контур (Шифрование транзита между контейнерами и подсетями)
simulation-api.internal, bank-service.internal {
    tls internal

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }

    reverse_proxy simulation-api:8002 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https

        transport http {
            response_header_timeout 60s
            read_timeout 60s
            write_timeout 60s
        }
    }
}

# 3. Внутренний контур Администратора (Межсетевое TLS-взаимодействие)
admin-server.internal {
    tls internal

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }

    reverse_proxy admin-server:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https

        transport http {
            response_header_timeout 180s
            read_timeout 180s
            write_timeout 180s
        }
    }
}

