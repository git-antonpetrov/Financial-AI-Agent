[flake8]
max-line-length = 120
# W503 в Ruff отсутствует: перенос перед оператором он не считает ошибкой.
extend-ignore = E203, W503
exclude = .git,.cache,venv,.venv,__pycache__,node_modules,src/admin_client/frontend/node_modules,data
per-file-ignores =
    src/simulations/api/main.py: E402
    src/simulations/workers/*: E402
    src/simulations/db/*/scripts/*: E402
    tests/*: E402, E501
